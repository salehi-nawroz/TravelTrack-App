# Copy to .env.local (never committed) and fill in from
# Supabase Dashboard -> Project Settings -> API. On Vercel, set the same
# variables under Project -> Settings -> Environment Variables.
#
# Everything starting with VITE_ is bundled into the public JavaScript, so
# only browser-safe values belong here: the project URL and the anon /
# publishable key. NEVER put the service_role / secret key here - the app
# refuses to start if you do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Trip tracking. Set to true once scripts/trips-schema.sql,
# scripts/setup-trip-photos-storage.mjs and
# scripts/trip-photos-storage-policies.sql have been applied to the project
# (they have been on the live project). Unset/false keeps the older,
# read-only Trips page.
VITE_TRIPS_ENABLED=false
